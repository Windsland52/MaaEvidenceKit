{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "source_component": {
          "minLength": 1,
          "title": "Source Component",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "reliability": {
          "$ref": "#/$defs/EvidenceReliability",
          "default": "primary"
        }
      },
      "required": [
        "id",
        "kind",
        "source_component",
        "source_path",
        "content"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceReliability": {
      "enum": [
        "primary",
        "secondary",
        "context"
      ],
      "title": "EvidenceReliability",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "default": "evidence-window/v1",
      "title": "Api Version",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "requested_line_start": {
      "minimum": 1,
      "title": "Requested Line Start",
      "type": "integer"
    },
    "requested_line_end": {
      "minimum": 1,
      "title": "Requested Line End",
      "type": "integer"
    },
    "has_more_before": {
      "title": "Has More Before",
      "type": "boolean"
    },
    "has_more_after": {
      "title": "Has More After",
      "type": "boolean"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "evidence",
    "requested_line_start",
    "requested_line_end",
    "has_more_before",
    "has_more_after"
  ],
  "title": "EvidenceWindow",
  "type": "object"
}
