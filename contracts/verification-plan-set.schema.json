{
  "$defs": {
    "VerificationMethod": {
      "enum": [
        "offline_screenshot",
        "static_configuration",
        "runtime_execution",
        "manual_observation"
      ],
      "title": "VerificationMethod",
      "type": "string"
    },
    "VerificationPlan": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "verification-plan/v2",
          "default": "verification-plan/v2",
          "title": "Api Version",
          "type": "string"
        },
        "fix_id": {
          "minLength": 1,
          "title": "Fix Id",
          "type": "string"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/VerificationMethod"
          },
          "minItems": 1,
          "title": "Methods",
          "type": "array"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "business_milestones": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Business Milestones",
          "type": "array"
        },
        "regression_checks": {
          "items": {
            "type": "string"
          },
          "title": "Regression Checks",
          "type": "array"
        }
      },
      "required": [
        "fix_id",
        "methods",
        "steps",
        "business_milestones"
      ],
      "title": "VerificationPlan",
      "type": "object"
    },
    "VerificationPlanningStatus": {
      "enum": [
        "planned",
        "skip"
      ],
      "title": "VerificationPlanningStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "planned"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "plans": {
            "minItems": 1
          }
        },
        "required": [
          "plans"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "skip"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "plans": {
            "maxItems": 0
          }
        },
        "required": [
          "plans"
        ]
      }
    }
  ],
  "description": "Pre-execution verification plans paired with validated fix candidates.",
  "properties": {
    "api_version": {
      "const": "verification-plan-set/v1",
      "default": "verification-plan-set/v1",
      "title": "Api Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/VerificationPlanningStatus"
    },
    "plans": {
      "description": "Use one to three plans when status is 'planned'; use an empty list when status is 'skip'.",
      "items": {
        "$ref": "#/$defs/VerificationPlan"
      },
      "maxItems": 3,
      "title": "Plans",
      "type": "array"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "status",
    "rationale"
  ],
  "title": "VerificationPlanSet",
  "type": "object"
}
