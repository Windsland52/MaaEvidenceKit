{
  "$defs": {
    "StructuredOutputMethod": {
      "enum": [
        "auto",
        "json_schema",
        "function_calling",
        "json_mode"
      ],
      "title": "StructuredOutputMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Serializable model selection without credential values.",
  "properties": {
    "api_version": {
      "const": "model-config/v1",
      "default": "model-config/v1",
      "title": "Api Version",
      "type": "string"
    },
    "provider": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "api_key_env": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Key Env"
    },
    "base_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Url"
    },
    "temperature": {
      "anyOf": [
        {
          "maximum": 2,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "timeout_seconds": {
      "default": 120,
      "exclusiveMinimum": 0,
      "maximum": 600,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "max_retries": {
      "default": 2,
      "maximum": 10,
      "minimum": 0,
      "title": "Max Retries",
      "type": "integer"
    },
    "structured_output_method": {
      "$ref": "#/$defs/StructuredOutputMethod",
      "default": "auto"
    }
  },
  "required": [
    "provider",
    "model"
  ],
  "title": "ModelConfig",
  "type": "object"
}
