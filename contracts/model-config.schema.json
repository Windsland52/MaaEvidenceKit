{
  "$defs": {
    "ChatTemplateConfig": {
      "additionalProperties": false,
      "description": "Provider chat-template controls passed with each model request.",
      "properties": {
        "thinking": {
          "title": "Thinking",
          "type": "boolean"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "enum": [
                "high",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        }
      },
      "required": [
        "thinking"
      ],
      "title": "ChatTemplateConfig",
      "type": "object"
    },
    "FunctionToolChoiceFormat": {
      "description": "Wire shape used to force a named function on compatible gateways.",
      "enum": [
        "chat_completions",
        "responses"
      ],
      "title": "FunctionToolChoiceFormat",
      "type": "string"
    },
    "StructuredOutputMethod": {
      "enum": [
        "auto",
        "json_schema",
        "function_calling",
        "json_mode"
      ],
      "title": "StructuredOutputMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Serializable model selection and provider connection settings.",
  "properties": {
    "api_version": {
      "const": "model-config/v1",
      "default": "model-config/v1",
      "title": "Api Version",
      "type": "string"
    },
    "provider": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "api_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Key"
    },
    "base_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Url"
    },
    "temperature": {
      "anyOf": [
        {
          "maximum": 2,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "timeout_seconds": {
      "default": 120,
      "exclusiveMinimum": 0,
      "maximum": 600,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "max_retries": {
      "default": 2,
      "maximum": 10,
      "minimum": 0,
      "title": "Max Retries",
      "type": "integer"
    },
    "max_output_tokens": {
      "anyOf": [
        {
          "maximum": 131072,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Output Tokens"
    },
    "structured_output_retries": {
      "default": 1,
      "maximum": 3,
      "minimum": 0,
      "title": "Structured Output Retries",
      "type": "integer"
    },
    "structured_output_method": {
      "$ref": "#/$defs/StructuredOutputMethod",
      "default": "auto"
    },
    "function_tool_choice_format": {
      "$ref": "#/$defs/FunctionToolChoiceFormat",
      "default": "chat_completions"
    },
    "chat_template_kwargs": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatTemplateConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "provider",
    "model"
  ],
  "title": "ModelConfig",
  "type": "object"
}
