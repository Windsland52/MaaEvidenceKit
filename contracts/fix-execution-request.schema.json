{
  "$defs": {
    "ProcessCommandRequest": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "process-command-request/v1",
          "default": "process-command-request/v1",
          "title": "Api Version",
          "type": "string"
        },
        "kind": {
          "const": "process",
          "default": "process",
          "title": "Kind",
          "type": "string"
        },
        "executable": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Executable",
          "type": "string"
        },
        "arguments": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Arguments",
          "type": "array"
        },
        "cwd": {
          "format": "path",
          "title": "Cwd",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_bytes": {
          "default": 100000,
          "maximum": 10000000,
          "minimum": 1024,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_output_lines": {
          "default": 2000,
          "maximum": 100000,
          "minimum": 10,
          "title": "Max Output Lines",
          "type": "integer"
        }
      },
      "required": [
        "executable",
        "cwd"
      ],
      "title": "ProcessCommandRequest",
      "type": "object"
    },
    "ShellCommandRequest": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "shell-command-request/v1",
          "default": "shell-command-request/v1",
          "title": "Api Version",
          "type": "string"
        },
        "kind": {
          "const": "shell",
          "default": "shell",
          "title": "Kind",
          "type": "string"
        },
        "command": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "cwd": {
          "format": "path",
          "title": "Cwd",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_bytes": {
          "default": 100000,
          "maximum": 10000000,
          "minimum": 1024,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_output_lines": {
          "default": 2000,
          "maximum": 100000,
          "minimum": 10,
          "title": "Max Output Lines",
          "type": "integer"
        }
      },
      "required": [
        "command",
        "cwd"
      ],
      "title": "ShellCommandRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One selected fix translated into one exact command pending human approval.",
  "properties": {
    "api_version": {
      "const": "fix-execution-request/v1",
      "default": "fix-execution-request/v1",
      "title": "Api Version",
      "type": "string"
    },
    "fix_id": {
      "minLength": 1,
      "title": "Fix Id",
      "type": "string"
    },
    "command": {
      "discriminator": {
        "mapping": {
          "process": "#/$defs/ProcessCommandRequest",
          "shell": "#/$defs/ShellCommandRequest"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ProcessCommandRequest"
        },
        {
          "$ref": "#/$defs/ShellCommandRequest"
        }
      ],
      "title": "Command"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "expected_changed_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Expected Changed Paths",
      "type": "array"
    }
  },
  "required": [
    "fix_id",
    "command",
    "rationale",
    "expected_changed_paths"
  ],
  "title": "FixExecutionRequest",
  "type": "object"
}
