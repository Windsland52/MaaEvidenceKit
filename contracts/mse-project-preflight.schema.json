{
  "$defs": {
    "MseCompatibility": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/MseCompatibilityStatus"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "MseCompatibility",
      "type": "object"
    },
    "MseCompatibilityStatus": {
      "enum": [
        "supported",
        "partial",
        "unsupported"
      ],
      "title": "MseCompatibilityStatus",
      "type": "string"
    },
    "MseConfigurationSummary": {
      "additionalProperties": false,
      "properties": {
        "controller": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Controller"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "resource_paths": {
          "items": {
            "type": "string"
          },
          "title": "Resource Paths",
          "type": "array"
        },
        "task_count": {
          "minimum": 0,
          "title": "Task Count",
          "type": "integer"
        },
        "pipeline_file_count": {
          "minimum": 0,
          "title": "Pipeline File Count",
          "type": "integer"
        },
        "diagnostic_count": {
          "minimum": 0,
          "title": "Diagnostic Count",
          "type": "integer"
        },
        "error_count": {
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        }
      },
      "required": [
        "task_count",
        "pipeline_file_count",
        "diagnostic_count",
        "error_count",
        "warning_count"
      ],
      "title": "MseConfigurationSummary",
      "type": "object"
    },
    "MseDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "level": {
          "pattern": "^(warning|error)$",
          "title": "Level",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "column": {
          "minimum": 1,
          "title": "Column",
          "type": "integer"
        },
        "length": {
          "minimum": 0,
          "title": "Length",
          "type": "integer"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "controller": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Controller"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        }
      },
      "required": [
        "type",
        "level",
        "source_path",
        "line",
        "column",
        "length",
        "message"
      ],
      "title": "MseDiagnostic",
      "type": "object"
    },
    "MseSyntaxMode": {
      "enum": [
        "maafw",
        "maa"
      ],
      "title": "MseSyntaxMode",
      "type": "string"
    },
    "MseTaskBinding": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "entry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry"
        }
      },
      "required": [
        "name"
      ],
      "title": "MseTaskBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "mde-mse-project-preflight/v2",
      "default": "mde-mse-project-preflight/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "project_root": {
      "format": "path",
      "title": "Project Root",
      "type": "string"
    },
    "interface_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interface Path"
    },
    "syntax_mode": {
      "$ref": "#/$defs/MseSyntaxMode"
    },
    "compatibility": {
      "$ref": "#/$defs/MseCompatibility"
    },
    "controllers": {
      "items": {
        "type": "string"
      },
      "title": "Controllers",
      "type": "array"
    },
    "resources": {
      "items": {
        "type": "string"
      },
      "title": "Resources",
      "type": "array"
    },
    "task_bindings": {
      "items": {
        "$ref": "#/$defs/MseTaskBinding"
      },
      "title": "Task Bindings",
      "type": "array"
    },
    "configurations": {
      "items": {
        "$ref": "#/$defs/MseConfigurationSummary"
      },
      "title": "Configurations",
      "type": "array"
    },
    "configurations_truncated": {
      "default": false,
      "title": "Configurations Truncated",
      "type": "boolean"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/MseDiagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "diagnostics_truncated": {
      "default": false,
      "title": "Diagnostics Truncated",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "project_root",
    "syntax_mode",
    "compatibility"
  ],
  "title": "MseProjectPreflightResult",
  "type": "object"
}
