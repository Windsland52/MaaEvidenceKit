{
  "$defs": {
    "WikiCatalogFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "WikiCatalogFile",
      "type": "object"
    },
    "WikiCatalogSource": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version",
        "revision"
      ],
      "title": "WikiCatalogSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "maa-llm-wiki-catalog/v1",
      "default": "maa-llm-wiki-catalog/v1",
      "title": "Api Version",
      "type": "string"
    },
    "wiki_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Wiki Revision",
      "type": "string"
    },
    "working_tree_clean": {
      "title": "Working Tree Clean",
      "type": "boolean"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/WikiCatalogSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/WikiCatalogFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "wiki_revision",
    "working_tree_clean",
    "sources",
    "files"
  ],
  "title": "WikiCatalogManifest",
  "type": "object"
}
