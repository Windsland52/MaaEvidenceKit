{
  "$defs": {
    "ArtifactSourceKind": {
      "enum": [
        "maa_framework",
        "gui",
        "custom",
        "unknown"
      ],
      "title": "ArtifactSourceKind",
      "type": "string"
    },
    "LogArtifactOverview": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/ArtifactSourceKind"
        },
        "status": {
          "$ref": "#/$defs/LogOverviewStatus"
        },
        "scanned_bytes": {
          "minimum": 0,
          "title": "Scanned Bytes",
          "type": "integer"
        },
        "scanned_lines": {
          "minimum": 0,
          "title": "Scanned Lines",
          "type": "integer"
        },
        "first_timestamp_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Timestamp Text"
        },
        "last_timestamp_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Timestamp Text"
        },
        "severity_counts": {
          "items": {
            "$ref": "#/$defs/LogSeverityCount"
          },
          "title": "Severity Counts",
          "type": "array"
        },
        "notable_occurrences": {
          "items": {
            "$ref": "#/$defs/LogOccurrence"
          },
          "title": "Notable Occurrences",
          "type": "array"
        },
        "oversized_line_count": {
          "default": 0,
          "minimum": 0,
          "title": "Oversized Line Count",
          "type": "integer"
        },
        "omitted_occurrence_count": {
          "default": 0,
          "minimum": 0,
          "title": "Omitted Occurrence Count",
          "type": "integer"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "source_kind",
        "status",
        "scanned_bytes",
        "scanned_lines"
      ],
      "title": "LogArtifactOverview",
      "type": "object"
    },
    "LogOccurrence": {
      "additionalProperties": false,
      "properties": {
        "line_number": {
          "minimum": 1,
          "title": "Line Number",
          "type": "integer"
        },
        "byte_offset": {
          "minimum": 0,
          "title": "Byte Offset",
          "type": "integer"
        },
        "timestamp_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Text"
        },
        "severity": {
          "$ref": "#/$defs/LogSeverity"
        },
        "excerpt": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "line_truncated": {
          "default": false,
          "title": "Line Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "line_number",
        "byte_offset",
        "severity",
        "excerpt"
      ],
      "title": "LogOccurrence",
      "type": "object"
    },
    "LogOverviewStatus": {
      "enum": [
        "complete",
        "truncated",
        "unreadable"
      ],
      "title": "LogOverviewStatus",
      "type": "string"
    },
    "LogSeverity": {
      "enum": [
        "trace",
        "debug",
        "info",
        "warning",
        "error",
        "critical",
        "unknown"
      ],
      "title": "LogSeverity",
      "type": "string"
    },
    "LogSeverityCount": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "$ref": "#/$defs/LogSeverity"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "severity",
        "count"
      ],
      "title": "LogSeverityCount",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "log-overview/v1",
      "default": "log-overview/v1",
      "title": "Api Version",
      "type": "string"
    },
    "overviews": {
      "items": {
        "$ref": "#/$defs/LogArtifactOverview"
      },
      "title": "Overviews",
      "type": "array"
    }
  },
  "title": "LogOverviewCollection",
  "type": "object"
}
