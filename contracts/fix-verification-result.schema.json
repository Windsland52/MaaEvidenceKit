{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "source_component": {
          "minLength": 1,
          "title": "Source Component",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "reliability": {
          "$ref": "#/$defs/EvidenceReliability",
          "default": "primary"
        }
      },
      "required": [
        "id",
        "kind",
        "source_component",
        "source_path",
        "content",
        "role"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceReliability": {
      "enum": [
        "primary",
        "secondary",
        "context"
      ],
      "title": "EvidenceReliability",
      "type": "string"
    },
    "EvidenceRole": {
      "description": "The diagnostic meaning of evidence, independent of its provenance quality.",
      "enum": [
        "failure",
        "signal",
        "context"
      ],
      "title": "EvidenceRole",
      "type": "string"
    },
    "FixVerificationCheck": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/FixVerificationCheckKind"
        },
        "requirement": {
          "minLength": 1,
          "title": "Requirement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "requirement",
        "status",
        "statement"
      ],
      "title": "FixVerificationCheck",
      "type": "object"
    },
    "FixVerificationCheckKind": {
      "enum": [
        "file_change",
        "step",
        "business_milestone",
        "regression"
      ],
      "title": "FixVerificationCheckKind",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "planned",
        "passed",
        "failed",
        "unavailable"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "fix-verification-result/v1",
      "default": "fix-verification-result/v1",
      "title": "Api Version",
      "type": "string"
    },
    "fix_id": {
      "minLength": 1,
      "title": "Fix Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/VerificationStatus"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/FixVerificationCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "fix_id",
    "status",
    "summary",
    "checks"
  ],
  "title": "FixVerificationResult",
  "type": "object"
}
