{
  "$defs": {
    "BenchmarkJudgmentDraft": {
      "additionalProperties": false,
      "description": "Judge-model output; Python validates every reference before scoring.",
      "properties": {
        "api_version": {
          "const": "benchmark-judgment-draft/v1",
          "default": "benchmark-judgment-draft/v1",
          "title": "Api Version",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "covered_required_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Covered Required Evidence Ids",
          "type": "array"
        },
        "matched_acceptable_conclusion_indexes": {
          "items": {
            "type": "integer"
          },
          "title": "Matched Acceptable Conclusion Indexes",
          "type": "array"
        },
        "matched_required_absence_indexes": {
          "items": {
            "type": "integer"
          },
          "title": "Matched Required Absence Indexes",
          "type": "array"
        },
        "violated_forbidden_claim_indexes": {
          "items": {
            "type": "integer"
          },
          "title": "Violated Forbidden Claim Indexes",
          "type": "array"
        },
        "acknowledged_missing_evidence_indexes": {
          "items": {
            "type": "integer"
          },
          "title": "Acknowledged Missing Evidence Indexes",
          "type": "array"
        },
        "separates_diagnostic_layers": {
          "title": "Separates Diagnostic Layers",
          "type": "boolean"
        },
        "citations_traceable": {
          "title": "Citations Traceable",
          "type": "boolean"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "separates_diagnostic_layers",
        "citations_traceable",
        "rationale"
      ],
      "title": "BenchmarkJudgmentDraft",
      "type": "object"
    },
    "BenchmarkMetrics": {
      "additionalProperties": false,
      "properties": {
        "required_evidence_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Required Evidence Coverage",
          "type": "number"
        },
        "acceptable_conclusion_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Acceptable Conclusion Coverage",
          "type": "number"
        },
        "required_absence_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Required Absence Coverage",
          "type": "number"
        },
        "missing_evidence_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Missing Evidence Coverage",
          "type": "number"
        },
        "diagnostic_layer_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Diagnostic Layer Score",
          "type": "number"
        },
        "citation_traceability_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Citation Traceability Score",
          "type": "number"
        },
        "forbidden_claim_penalty": {
          "maximum": 1,
          "minimum": 0,
          "title": "Forbidden Claim Penalty",
          "type": "number"
        }
      },
      "required": [
        "required_evidence_coverage",
        "acceptable_conclusion_coverage",
        "required_absence_coverage",
        "missing_evidence_coverage",
        "diagnostic_layer_score",
        "citation_traceability_score",
        "forbidden_claim_penalty"
      ],
      "title": "BenchmarkMetrics",
      "type": "object"
    },
    "BenchmarkRubricCounts": {
      "additionalProperties": false,
      "properties": {
        "required_evidence": {
          "minimum": 1,
          "title": "Required Evidence",
          "type": "integer"
        },
        "acceptable_conclusions": {
          "minimum": 1,
          "title": "Acceptable Conclusions",
          "type": "integer"
        },
        "required_absences": {
          "minimum": 0,
          "title": "Required Absences",
          "type": "integer"
        },
        "forbidden_claims": {
          "minimum": 0,
          "title": "Forbidden Claims",
          "type": "integer"
        },
        "missing_evidence": {
          "minimum": 0,
          "title": "Missing Evidence",
          "type": "integer"
        }
      },
      "required": [
        "required_evidence",
        "acceptable_conclusions",
        "required_absences",
        "forbidden_claims",
        "missing_evidence"
      ],
      "title": "BenchmarkRubricCounts",
      "type": "object"
    },
    "DiagnosisStatus": {
      "enum": [
        "complete",
        "insufficient_evidence",
        "not_applicable",
        "failed"
      ],
      "title": "DiagnosisStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "benchmark-result/v1",
      "default": "benchmark-result/v1",
      "title": "Api Version",
      "type": "string"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "diagnosis_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Diagnosis Sha256",
      "type": "string"
    },
    "diagnosis_status": {
      "$ref": "#/$defs/DiagnosisStatus"
    },
    "judgment": {
      "$ref": "#/$defs/BenchmarkJudgmentDraft"
    },
    "rubric_counts": {
      "$ref": "#/$defs/BenchmarkRubricCounts"
    },
    "metrics": {
      "$ref": "#/$defs/BenchmarkMetrics"
    },
    "score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "pass_threshold": {
      "maximum": 1,
      "minimum": 0,
      "title": "Pass Threshold",
      "type": "number"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    }
  },
  "required": [
    "case_id",
    "diagnosis_sha256",
    "diagnosis_status",
    "judgment",
    "rubric_counts",
    "metrics",
    "score",
    "pass_threshold",
    "passed"
  ],
  "title": "BenchmarkResult",
  "type": "object"
}
