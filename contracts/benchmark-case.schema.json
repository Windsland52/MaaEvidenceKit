{
  "$defs": {
    "BenchmarkArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https://github\\.com/",
          "title": "Source Url",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/BenchmarkPayload"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "privacy_review": {
          "const": "pass",
          "title": "Privacy Review",
          "type": "string"
        },
        "redistribution": {
          "enum": [
            "download_only",
            "redistributable"
          ],
          "title": "Redistribution",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "artifact_id",
        "source_url",
        "filename",
        "payload",
        "captured_at",
        "privacy_review",
        "redistribution",
        "required"
      ],
      "title": "BenchmarkArtifact",
      "type": "object"
    },
    "BenchmarkIssueSnapshot": {
      "additionalProperties": false,
      "properties": {
        "issue_url": {
          "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[0-9]+$",
          "title": "Issue Url",
          "type": "string"
        },
        "snapshot_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Revision",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/BenchmarkPayload"
        }
      },
      "required": [
        "issue_url",
        "snapshot_revision",
        "payload"
      ],
      "title": "BenchmarkIssueSnapshot",
      "type": "object"
    },
    "BenchmarkPayload": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "media_type",
        "size_bytes",
        "label"
      ],
      "title": "BenchmarkPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Observation-cutoff manifest; payloads remain external and hash-addressed.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Case Id",
      "type": "string"
    },
    "source_candidate_id": {
      "minLength": 1,
      "title": "Source Candidate Id",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "repository": {
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "title": "Repository",
      "type": "string"
    },
    "issue_number": {
      "minimum": 1,
      "title": "Issue Number",
      "type": "integer"
    },
    "tier": {
      "enum": [
        "gold",
        "silver"
      ],
      "title": "Tier",
      "type": "string"
    },
    "split": {
      "enum": [
        "stable",
        "development",
        "holdout"
      ],
      "title": "Split",
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "l1",
        "l2",
        "l3"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "observation_cutoff": {
      "format": "date-time",
      "title": "Observation Cutoff",
      "type": "string"
    },
    "annotation_cutoff": {
      "format": "date-time",
      "title": "Annotation Cutoff",
      "type": "string"
    },
    "visible_issue_snapshot": {
      "$ref": "#/$defs/BenchmarkIssueSnapshot"
    },
    "visible_artifacts": {
      "items": {
        "$ref": "#/$defs/BenchmarkArtifact"
      },
      "minItems": 1,
      "title": "Visible Artifacts",
      "type": "array"
    },
    "issue_source_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Issue Source Revision",
      "type": "string"
    },
    "tasks": {
      "items": {
        "const": "diagnose_at_report_time",
        "type": "string"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    },
    "coverage_tags": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Coverage Tags",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "source_candidate_id",
    "project_id",
    "repository",
    "issue_number",
    "tier",
    "split",
    "difficulty",
    "observation_cutoff",
    "annotation_cutoff",
    "visible_issue_snapshot",
    "visible_artifacts",
    "issue_source_revision",
    "tasks",
    "coverage_tags"
  ],
  "title": "BenchmarkCase",
  "type": "object"
}
