{
  "$defs": {
    "Conclusion": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "statement",
        "evidence_ids",
        "confidence"
      ],
      "title": "Conclusion",
      "type": "object"
    },
    "DiagnosisStatus": {
      "enum": [
        "complete",
        "insufficient_evidence",
        "not_applicable",
        "failed"
      ],
      "title": "DiagnosisStatus",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "source_component": {
          "minLength": 1,
          "title": "Source Component",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "reliability": {
          "$ref": "#/$defs/EvidenceReliability",
          "default": "primary"
        }
      },
      "required": [
        "id",
        "kind",
        "source_component",
        "source_path",
        "content",
        "role"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceReliability": {
      "enum": [
        "primary",
        "secondary",
        "context"
      ],
      "title": "EvidenceReliability",
      "type": "string"
    },
    "EvidenceRole": {
      "description": "The diagnostic meaning of evidence, independent of its provenance quality.",
      "enum": [
        "failure",
        "signal",
        "context"
      ],
      "title": "EvidenceRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "default": "diagnosis/v2",
      "title": "Api Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DiagnosisStatus"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "conclusions": {
      "items": {
        "$ref": "#/$defs/Conclusion"
      },
      "title": "Conclusions",
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Missing Evidence",
      "type": "array"
    }
  },
  "required": [
    "status",
    "summary"
  ],
  "title": "DiagnosisResult",
  "type": "object"
}
