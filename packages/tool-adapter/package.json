{
  "name": "@maa-diagnostic-expert/tool-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mde-tool-adapter": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild dist/bundle.js --bundle --platform=node --format=cjs --target=node24 --main-fields=module,main --define:import.meta.url=undefined --outfile=../../src/maa_diagnostic_expert/_tool_adapter/cli.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/index.test.js dist/cli.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@nekosu/maa-pipeline-manager": "1.0.12",
    "@nekosu/maa-tasker": "1.0.0",
    "@windsland52/maa-log-tools": "1.3.0"
  },
  "devDependencies": {
    "@maaxyz/maa-node": "5.12.2",
    "esbuild": "0.28.1"
  }
}
